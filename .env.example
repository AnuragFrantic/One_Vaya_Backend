# ──────────────────────────────────────────────────────────────
#  OneVaya backend — environment settings
#  Copy to `.env` and fill in. NEVER commit the real `.env`.
#  Every external service works in a safe "fallback" mode when its
#  key is empty, so the API runs end-to-end before you buy anything.
# ──────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Frontend URL(s) allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3000
# Public URL of the website (used in email links)
CLIENT_URL=http://localhost:3000
# Public URL of this API (used for document download links)
API_URL=http://localhost:5000

# ── Database (MongoDB) ────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/onevaya
# true = start a temporary in-memory MongoDB (no install needed, data is lost on restart)
USE_MEMORY_DB=false
# Optional: DNS server(s) for mongodb+srv:// lookups. Only set if you get "querySrv ECONNREFUSED".
DNS_SERVERS=

# ── Auth ──────────────────────────────────────────────────────
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=ov_session
# true in production (HTTPS only)
COOKIE_SECURE=false

# ── Claude API (AI chatbot + AI itinerary planner) ────────────
# Empty = DEMO MODE (rule-based replies, no cost). Paste the key to go live — nothing else changes.
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-haiku-5-5
AI_PLANNER_MODEL=claude-opus-5-5
# Max user messages per chat conversation before suggesting a human
AI_CHAT_MAX_TURNS=20

# ── Email (SMTP) ──────────────────────────────────────────────
# Empty SMTP_HOST = emails are printed to the console instead of sent
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="OneVaya Travel & Tourism <hello@onevaya.com>"
# Where new-lead notifications go
TEAM_EMAIL=team@onevaya.com

# ── File storage (customer travel documents) ─────────────────
# local = ./uploads folder · s3 = private S3-compatible bucket (AWS S3, Cloudflare R2, Wasabi…)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, for non-AWS providers (e.g. https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# Secret used to sign short-lived document download links
FILE_URL_SECRET=change-me-too
DOWNLOAD_LINK_TTL_MINUTES=10
MAX_UPLOAD_MB=15

# ── First admin account (created by `npm run seed`) ──────────
ADMIN_NAME=OneVaya Admin
ADMIN_EMAIL=admin@onevaya.com
ADMIN_PASSWORD=ChangeMe!2026
